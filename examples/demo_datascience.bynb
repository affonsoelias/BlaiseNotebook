{
  "metadata": {
    "name": "demo_datascience",
    "framework": "BlaiseVue",
    "engine": "Synopse mORMot 2 + Free Pascal + Python4Delphi",
    "license": "Modified LGPL v2.1 with Static Linking Exception",
