<template>
  <div class="bv-markdown-root" :class="{ 'bv-md-editing': isEditing }">
    <div class="bv-md-header">
      <div class="bv-md-badge">
        <span class="md-icon">📝</span>
        <span class="md-text">Documentation / Markdown</span>
      </div>
      <div class="bv-md-actions">
        <button type="button" class="bv-md-btn btn-edit" @click="startEdit">✏️ Edit (Double-click)</button>
        <button type="button" class="bv-md-btn btn-save" @click="finishEdit">👁️ Done Editing (Ctrl+Enter)</button>
      </div>
    </div>

    <!-- VIEW MODE -->
    <div
      b-ref="renderedDiv"
      class="bv-md-rendered"
      @dblclick="startEdit"
    ></div>

    <!-- EDIT MODE -->
    <div class="bv-md-editor-wrap">
      <textarea
        b-ref="mdTextarea"
        class="bv-md-textarea"
        placeholder="# Enter Markdown here..."
        @input="handleInput"
        @keydown="handleKeyDown"
      ></textarea>
      <div class="bv-md-editor-hint">
        Hint: Supports headings (#, ##), lists (-), bold (**), code (`), and equation blocks. Press <code>Ctrl + Enter</code> to render.
      </div>
    </div>
  </div>
</template>

<script>
  {
    BvMarkdown.bv - Markdown Rendering & Inline Editor
    Part of BlaiseNotebook Suite (Modified LGPL v2.1 with Linking Exception)
  }

  props:
    value: string = '# Section Title\nDescribe your experiment, analysis, or methodology here.';
    editable: boolean = true;

  data:
    isEditing: boolean = false;

  computed:
    function renderedHtml: string;
    var
      raw: string;
    begin
      asm
        const text = (this._textBuffer !== undefined ? this._textBuffer : this.value) || '';
        if (!text.trim()) {
          return '<p class="bv-md-empty"><em>(Empty documentation cell. Double-click to edit.)</em></p>';
        }

        // Basic clean parser for Markdown:
        let html = text
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');

        // Code blocks: ```...```
        html = html.replace(/```([a-zA-Z0-9_-]*)\n([\s\S]*?)```/g, function(match, lang, code) {
          return '<pre class="bv-md-pre"><code class="lang-' + lang + '">' + code.trim() + '</code></pre>';
        });

        // Inline code: `...`
        html = html.replace(/`([^`]+)`/g, '<code class="bv-md-code">$1</code>');

        // Headers
        html = html.replace(/^### (.*$)/gim, '<h3 class="bv-md-h3">$1</h3>');
        html = html.replace(/^## (.*$)/gim, '<h2 class="bv-md-h2">$1</h2>');
        html = html.replace(/^# (.*$)/gim, '<h1 class="bv-md-h1">$1</h1>');

        // Bold & Italic
        html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/\*([^*]+)\*/g, '<em>$1</em>');

        // Blockquotes
        html = html.replace(/^\> (.*$)/gim, '<blockquote class="bv-md-quote">$1</blockquote>');

        // Bullet lists
        html = html.replace(/^\- (.*$)/gim, '<li class="bv-md-li">$1</li>');
        html = html.replace(/(<li class="bv-md-li">[\s\S]*?<\/li>)/gim, '<ul class="bv-md-ul">$1</ul>');

        // Math/Formula markers: $$...$$ and $...$
        html = html.replace(/\$\$([\s\S]*?)\$\$/g, '<div class="bv-md-math-block">🧮 <code>$1</code></div>');
        html = html.replace(/\$([^$]+)\$/g, '<span class="bv-md-math-inline"><code>$1</code></span>');

        // Links: [text](url)
        html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="bv-md-link">$1</a>');

        // Line breaks (convert non-tag breaks to <br> or wrap in <p>)
        const lines = html.split('\n');
        let out = '';
        for (let i = 0; i < lines.length; i++) {
          const l = lines[i].trim();
          if (!l) continue;
          if (l.startsWith('<h') || l.startsWith('<pre') || l.startsWith('<ul') || l.startsWith('<blockquote') || l.startsWith('<div')) {
            out += l;
          } else {
            out += '<p class="bv-md-p">' + l + '</p>';
          }
        }
        return out;
      end;
    end;

  methods:
    procedure renderHtmlContent;
    begin
      asm
        const el = this.$refs ? this.$refs.renderedDiv : null;
        if (el) {
          el.innerHTML = this.renderedHtml;
        }
      end;
    end;

    procedure startEdit;
    begin
      this['isEditing'] := true;
      asm
        const self = this;
        const initialVal = self._textBuffer !== undefined ? self._textBuffer : (self.value || '');
        self._textBuffer = initialVal;
        const syncTa = function() {
          const ta = self.$refs ? self.$refs.mdTextarea : null;
          if (ta) {
            ta.value = initialVal;
            ta.focus();
            ta.style.height = 'auto';
            ta.style.height = Math.max(100, ta.scrollHeight) + 'px';
          }
        };
        syncTa();
        setTimeout(syncTa, 30);
      end;
    end;

    procedure finishEdit;
    begin
      this['isEditing'] := false;
      asm
        const ta = this.$refs ? this.$refs.mdTextarea : null;
        const finalVal = ta ? ta.value : (this._textBuffer !== undefined ? this._textBuffer : (this.value || ''));
        this._textBuffer = finalVal;
        this.renderHtmlContent();
        if (this.$emit) {
          this.$emit('input', finalVal);
          this.$emit('change', finalVal);
        }
      end;
    end;

    procedure handleInput(e: JSValue);
    begin
      asm
        const target = e && e.target ? e.target : null;
        if (target) {
          this._textBuffer = target.value;
          target.style.height = 'auto';
          target.style.height = Math.max(100, target.scrollHeight) + 'px';
        }
      end;
    end;

    procedure handleKeyDown(e: JSValue);
    begin
      asm
        const evt = e || window.event;
        if (!evt) return;
        evt.stopPropagation();
        if (evt.key === 'Enter' && (evt.ctrlKey || evt.metaKey || evt.shiftKey)) {
          evt.preventDefault();
          this.finishEdit();
        } else if (evt.key === 'Escape') {
          evt.preventDefault();
          this.finishEdit();
        }
      end;
    end;

  mounted:
    begin
      asm
        this._textBuffer = this.value || '';
        const ta = this.$refs ? this.$refs.mdTextarea : null;
        if (ta) {
          ta.value = this._textBuffer;
        }
        this.renderHtmlContent();
      end;
    end;

  watch:
    procedure value(newVal: string);
    begin
      asm
        const self = this;
        if (!self.isEditing) {
          self._textBuffer = newVal || '';
          const ta = self.$refs ? self.$refs.mdTextarea : null;
          if (ta) {
            ta.value = newVal || '';
          }
          self.renderHtmlContent();
        }
      end;
    end;
</script>

<style>
  /* PURE CSS VISIBILITY TOGGLE (PREVENTS DOM UNMOUNTING OR DIRECTIVE TRAVERSAL) */
  .bv-markdown-root .bv-md-rendered {
    display: block;
  }
  .bv-markdown-root .bv-md-editor-wrap {
    display: none;
  }
  .bv-markdown-root .btn-edit {
    display: inline-block;
  }
  .bv-markdown-root .btn-save {
    display: none;
  }

  .bv-markdown-root.bv-md-editing .bv-md-rendered {
    display: none !important;
  }
  .bv-markdown-root.bv-md-editing .bv-md-editor-wrap {
    display: flex !important;
  }
  .bv-markdown-root.bv-md-editing .btn-edit {
    display: none !important;
  }
  .bv-markdown-root.bv-md-editing .btn-save {
    display: inline-block !important;
  }
  .bv-markdown-root {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 16px;
    transition: all 0.2s;
  }

  .bv-md-editing {
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
  }

  .bv-md-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 6px;
    margin-bottom: 8px;
    border-bottom: 1px solid #f1f5f9;
  }

  .bv-md-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
  }

  .bv-md-actions {
    display: flex;
    gap: 6px;
  }

  .bv-md-btn {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #475569;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 11px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .bv-md-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  .btn-save {
    background: #10b981;
    color: white;
    border-color: #059669;
    font-weight: 600;
  }

  .btn-save:hover {
    background: #059669;
    color: white;
  }

  .bv-md-rendered {
    min-height: 40px;
    cursor: pointer;
    font-size: 14.5px;
    line-height: 1.6;
    color: #1e293b;
  }

  .bv-md-empty {
    color: #94a3b8;
    font-style: italic;
    margin: 8px 0;
  }

  .bv-md-h1 {
    font-size: 20px;
    font-weight: 700;
    margin: 12px 0 8px 0;
    color: #0f172a;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 4px;
  }

  .bv-md-h2 {
    font-size: 17px;
    font-weight: 600;
    margin: 10px 0 6px 0;
    color: #1e293b;
  }

  .bv-md-h3 {
    font-size: 15px;
    font-weight: 600;
    margin: 8px 0 4px 0;
    color: #334155;
  }

  .bv-md-p {
    margin: 6px 0;
  }

  .bv-md-code {
    background: #f1f5f9;
    color: #0f172a;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
  }

  .bv-md-pre {
    background: #0f172a;
    color: #f8fafc;
    padding: 10px 14px;
    border-radius: 6px;
    overflow-x: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    margin: 8px 0;
  }

  .bv-md-quote {
    border-left: 3px solid #3b82f6;
    background: #eff6ff;
    padding: 6px 12px;
    margin: 8px 0;
    color: #1e40af;
    border-radius: 0 4px 4px 0;
  }

  .bv-md-ul {
    padding-left: 20px;
    margin: 6px 0;
  }

  .bv-md-li {
    margin-bottom: 3px;
  }

  .bv-md-math-block {
    background: #faf5ff;
    border: 1px dashed #c084fc;
    color: #6b21a8;
    padding: 8px 12px;
    border-radius: 6px;
    margin: 8px 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
  }

  .bv-md-math-inline code {
    background: #faf5ff;
    color: #7e22ce;
    padding: 1px 5px;
    border-radius: 3px;
    font-family: 'JetBrains Mono', monospace;
  }

  .bv-md-link {
    color: #2563eb;
    text-decoration: underline;
  }

  .bv-md-editor-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bv-md-textarea {
    width: 100%;
    min-height: 100px;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px;
    line-height: 1.5;
    outline: none;
    resize: none;
    box-sizing: border-box;
    background: #f8fafc;
    color: #0f172a;
  }

  .bv-md-editor-hint {
    font-size: 11px;
    color: #64748b;
  }

  .bv-md-editor-hint code {
    background: #e2e8f0;
    padding: 1px 4px;
    border-radius: 3px;
  }

  /* DARK THEME STYLING FOR MARKDOWN */
  html[data-bs-theme="dark"] .bv-markdown-root,
  html.theme-dark .bv-markdown-root,
  body.theme-dark .bv-markdown-root {
    background: #111827 !important;
    border-color: #1f2937 !important;
    color: #e5e7eb !important;
  }

  html[data-bs-theme="dark"] .bv-md-header,
  html.theme-dark .bv-md-header {
    border-bottom: 1px solid #1f2937 !important;
  }

  html[data-bs-theme="dark"] .bv-md-btn,
  html.theme-dark .bv-md-btn {
    background: #1f2937 !important;
    border-color: #374151 !important;
    color: #9ca3af !important;
  }

  html[data-bs-theme="dark"] .bv-md-btn:hover,
  html.theme-dark .bv-md-btn:hover {
    background: #374151 !important;
    color: #ffffff !important;
  }

  html[data-bs-theme="dark"] .bv-md-rendered,
  html.theme-dark .bv-md-rendered {
    color: #e5e7eb !important;
  }

  html[data-bs-theme="dark"] .bv-md-h1,
  html.theme-dark .bv-md-h1 {
    color: #f9fafb !important;
    border-bottom-color: #1f2937 !important;
  }

  html[data-bs-theme="dark"] .bv-md-h2,
  html.theme-dark .bv-md-h2 {
    color: #f3f4f6 !important;
  }

  html[data-bs-theme="dark"] .bv-md-h3,
  html.theme-dark .bv-md-h3 {
    color: #e5e7eb !important;
  }

  html[data-bs-theme="dark"] .bv-md-code,
  html.theme-dark .bv-md-code {
    background: #1f2937 !important;
    color: #60a5fa !important;
  }

  html[data-bs-theme="dark"] .bv-md-quote,
  html.theme-dark .bv-md-quote {
    background: rgba(59, 130, 246, 0.12) !important;
    border-left-color: #3b82f6 !important;
    color: #93c5fd !important;
  }

  html[data-bs-theme="dark"] .bv-md-textarea,
  html.theme-dark .bv-md-textarea {
    background: #090d16 !important;
    border-color: #374151 !important;
    color: #f3f4f6 !important;
  }
</style>
