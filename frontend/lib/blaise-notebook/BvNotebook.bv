<template>
  <div class="bv-notebook-workspace" :class="{ 'is-dashboard-mode': isDashboardMode, 'is-outline-open': showOutlineDrawer }">
    <!-- NOTEBOOK TOP HEADER (BRAND & METADATA) -->
    <header class="notebook-header">
      <div class="header-left">
        <div class="notebook-brand">
          <span class="brand-logo">📐</span>
          <div class="brand-titles">
            <h1 class="notebook-title">BlaiseNotebook</h1>
            <span class="notebook-subtitle">Interactive Scientific Environment in Object Pascal</span>
          </div>
        </div>
        <div class="notebook-file-tag">
          <input
            type="text"
            class="file-name-input"
            b-model="notebookName"
            title="Click to rename notebook file"
          />
          <span class="ext-badge">.bynb</span>
        </div>
      </div>

      <div class="header-right">
        <!-- KERNEL STATUS BADGE -->
        <div class="kernel-status-pill" :class="kernelStatusClass">
          <span class="kernel-status-dot"></span>
          <span class="kernel-status-text">{{ kernelStatusText }}</span>
        </div>
      </div>
    </header>

    <!-- GLOBAL NOTEBOOK TOOLBAR -->
    <div class="notebook-toolbar">
      <div class="toolbar-group">
        <button class="tb-btn tb-btn-primary" @click="runAllCells" :disabled="isRunning" title="Run all code cells in sequence">
          ▶▶ Run All
        </button>
        <button class="tb-btn tb-btn-warning" :class="{ 'btn-interrupt-active': isRunning }" @click="interruptKernel" :disabled="!isRunning" title="Interrupt running execution in Kernel">
          ⏹ Interrupt
        </button>
        <button class="tb-btn" @click="restartKernel" title="Restart Kernel (Clear session memory & variables)">
          🔄 Restart Kernel
        </button>
        <button class="tb-btn" @click="addCodeCell" title="Add Object Pascal code cell">
          ➕ Pascal Code
        </button>
        <button class="tb-btn" @click="addMarkdownCell" title="Add Markdown documentation cell">
          ➕ Documentation
        </button>
        <button class="tb-btn tb-btn-snippets" @click="openSnippetsModal" title="Catálogo de Snippets e Receitas de Código Prontas">
          📚 Receitas
        </button>
        <button class="tb-btn" @click="clearAllOutputs" title="Clear all cell outputs">
          🧹 Clear Outputs
        </button>
      </div>

      <div class="toolbar-group">
        <button
          class="tb-btn"
          :disabled="!canUndo"
          @click="undoAction"
          title="Desfazer alteração estrutural de células (Ctrl+Z)"
        >
          ↩️ Desfazer
        </button>
        <button
          class="tb-btn"
          :disabled="!canRedo"
          @click="redoAction"
          title="Refazer alteração estrutural de células (Ctrl+Y)"
        >
          ↪️ Refazer
        </button>
        <button
          b-if="trashCount > 0"
          class="tb-btn tb-btn-trash"
          @click="openTrashModal"
          title="Ver lixeira de células deletadas"
        >
          🗑️ Lixeira ({{ trashCount }})
        </button>
        <button
          class="tb-btn tb-btn-outline"
          :class="{ 'btn-outline-active': showOutlineDrawer }"
          @click="toggleOutlineDrawer"
          title="Tabela de Conteúdos Automática / Sumário (Outline / TOC)"
        >
          📑 Sumário ({{ outlineCount }})
        </button>
        <button
          class="tb-btn tb-btn-dashboard"
          :class="{ 'btn-dashboard-active': isDashboardMode }"
          @click="toggleDashboardMode"
          title="Alternar Modo Dashboard (Apenas Saídas / Apresentação Executiva)"
        >
          {{ isDashboardMode ? '✏️ Modo Edição' : '📊 Dashboard View' }}
        </button>
        <button class="tb-btn" @click="exportNotebookJson" title="Save notebook (.bynb)">
          💾 Save (.bynb)
        </button>
        <label class="tb-btn tb-file-label" title="Open notebook (.bynb)">
          📂 Open
          <input id="hidden-notebook-file-input" type="file" accept=".bynb,.json" style="display:none;" @change="importNotebookJson" />
        </label>
      </div>
    </div>

    <!-- EXECUTIVE DASHBOARD MODE BANNER -->
    <div b-if="isDashboardMode" class="dashboard-banner">
      <div class="dash-banner-left">
        <span class="dash-badge">📊 DASHBOARD VIEW</span>
        <span class="dash-title">{{ notebookName || 'Executive Dashboard' }}</span>
        <span class="dash-sub">• Apresentação Executiva Interativa (Apenas Saídas)</span>
      </div>
      <div class="dash-banner-right">
        <button class="dash-btn-exit" @click="toggleDashboardMode" title="Retornar ao modo editor">
          ✏️ Sair do Dashboard
        </button>
      </div>
    </div>

    <!-- MAIN WORKSPACE BODY (COLLAPSIBLE OUTLINE DRAWER + CELLS CANVAS) -->
    <div class="notebook-body-layout">
      <!-- COLLAPSIBLE AUTOMATIC TABLE OF CONTENTS (OUTLINE / TOC) -->
      <aside class="notebook-outline-drawer" :class="{ 'outline-open': showOutlineDrawer }">
        <div class="outline-drawer-header">
          <div class="outline-header-title">
            <span class="outline-icon">📑</span>
            <span>Sumário (Outline)</span>
            <span class="outline-count-pill">{{ outlineCount }}</span>
          </div>
          <button class="outline-close-btn" @click="toggleOutlineDrawer" title="Recolher Sumário">
            ✕
          </button>
        </div>

        <div class="outline-drawer-body">
          <div b-if="outlineCount === 0" class="outline-empty-state">
            <div class="outline-empty-icon">📝</div>
            <p class="outline-empty-title">Nenhum título encontrado</p>
            <p class="outline-empty-desc">
              Adicione títulos Markdown com <code>#</code>, <code>##</code> ou <code>###</code> nas células de documentação para gerar o sumário automaticamente.
            </p>
          </div>

          <ul class="outline-nav-list">
            <li
              b-for="entry in outlineItems"
              :key="entry.id"
              class="outline-nav-item"
              :class="'outline-level-' + entry.level"
              @click="scrollToOutlineItem(entry)"
              :title="'Ir para Célula #' + (entry.cellIndex + 1) + ': ' + entry.text"
            >
              <span class="outline-item-marker">{{ entry.badge }}</span>
              <span class="outline-item-text">{{ entry.text }}</span>
              <span class="outline-item-cell">#{{ entry.cellIndex + 1 }}</span>
            </li>
          </ul>
        </div>
      </aside>

      <!-- REACTIVE CANVAS OF CELLS -->
      <main
        class="notebook-cells-canvas"
        @dragover="onCanvasDragOver($event)"
        @drop="onCanvasDrop($event)"
      >
      <div
        b-for="cell in cells"
        :key="cell.id"
        class="cell-wrapper-outer"
        :data-cell-index="$index"
        @dragover="onCellDragOver($index, $event)"
        @dragleave="onCellDragLeave($index, $event)"
        @drop="onCellDrop($index, $event)"
      >
        <!-- ANIMATED LIVE DROP SLOT (TOP) -->
        <div class="cell-drop-indicator drop-indicator-line-top" aria-hidden="true">
          <div class="drop-slot-box">
            <span class="drop-indicator-dot"></span>
            <span class="drop-indicator-badge">Soltar célula nesta posição</span>
            <span class="drop-indicator-line"></span>
          </div>
        </div>

        <!-- QUICK INSERT DIVIDER BETWEEN CELLS -->
        <div class="cell-inserter-divider">
          <div class="divider-line"></div>
          <div class="divider-buttons">
            <button class="btn-divider-add" @click="insertCodeAt($index)">+ Code</button>
            <button class="btn-divider-add" @click="insertMarkdownAt($index)">+ Markdown</button>
            <button class="btn-divider-add btn-divider-snippet" @click="openSnippetsAt($index)">📚 + Receita</button>
          </div>
          <div class="divider-line"></div>
        </div>

        <!-- CELL COMPONENT -->
        <bv-cell
          :cell="cell"
          :index="$index"
          :total="cells.length"
          @run="executeCell"
          @stop="stopCell"
          @move-up="moveCellUp"
          @move-down="moveCellDown"
          @insert-below="insertBelowIndex"
          @insert-code-below="insertCodeBelowIndex"
          @insert-markdown-below="insertMarkdownBelowIndex"
          @delete="deleteCellAt"
          @change-type="onCellTypeChanged"
          @source-change="onCellSourceChanged"
          @cell-drag-start="onCellDragStart"
          @cell-drag-end="onCellDragEnd"
        ></bv-cell>

        <!-- ANIMATED LIVE DROP SLOT (BOTTOM) -->
        <div class="cell-drop-indicator drop-indicator-line-bottom" aria-hidden="true">
          <div class="drop-slot-box">
            <span class="drop-indicator-dot"></span>
            <span class="drop-indicator-badge">Soltar célula nesta posição</span>
            <span class="drop-indicator-line"></span>
          </div>
        </div>
      </div>

      <!-- BOTTOM INSERTION BUTTONS -->
      <div class="canvas-bottom-inserter">
        <button class="btn-large-add" @click="addCodeCell">➕ Add Code Cell</button>
        <button class="btn-large-add" @click="addMarkdownCell">📝 Add Markdown Cell</button>
        <button class="btn-large-add btn-large-snippet" @click="openSnippetsModal">📚 Inserir Receita de Código</button>
      </div>
      </main>
    </div>

    <!-- QUICK RESTORE / UNDO FLOATING TOAST -->
    <div b-if="undoToastVisible" class="notebook-undo-toast">
      <div class="undo-toast-content">
        <span class="undo-toast-icon">🗑️</span>
        <span class="undo-toast-text">{{ undoToastMessage }}</span>
        <button class="btn-toast-restore" @click="restoreLastDeletedCell">
          ↩️ Restaurar Célula
        </button>
        <button class="btn-toast-close" @click="closeUndoToast" title="Fechar notificação">
          ✕
        </button>
      </div>
    </div>

    <!-- TRASH MODAL (LIXEIRA DE CÉLULAS) -->
    <div b-if="showTrashModal" class="trash-modal-backdrop" @click="closeTrashModal">
      <div class="trash-modal-card" @click="onModalCardClick">
        <div class="trash-modal-header">
          <div class="trash-modal-title">
            <span>🗑️ Lixeira de Células</span>
            <span class="trash-modal-count">({{ trashCount }} células)</span>
          </div>
          <button class="trash-modal-close" @click="closeTrashModal">✕</button>
        </div>
        <div class="trash-modal-body">
          <p class="trash-modal-desc">
            Células excluídas durante esta sessão. Você pode restaurar qualquer célula de volta ao notebook com código e saídas preservados.
          </p>
          <div b-if="trashCount === 0" class="trash-empty-state">
            A lixeira está vazia. Nenhuma célula deletada nesta sessão.
          </div>
          <div class="trash-items-list">
            <div b-for="item in trashList" :key="item.id" class="trash-item-row">
              <div class="trash-item-info">
                <span class="trash-item-type-badge" :class="'badge-' + item.type">
                  {{ item.type === 'code' ? '⚡ Pascal' : '📝 Markdown' }}
                </span>
                <span class="trash-item-index">Posição original: #{{ item.originalIndex + 1 }}</span>
                <span class="trash-item-time">{{ item.deletedTime }}</span>
              </div>
              <pre class="trash-item-snippet">{{ item.snippet }}</pre>
              <div class="trash-item-actions">
                <button class="btn-restore-item" @click="restoreTrashItem(item.id)">
                  ↩️ Restaurar
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="trash-modal-footer">
          <button class="tb-btn" @click="clearTrash">Esvaziar Lixeira</button>
          <button class="tb-btn tb-btn-primary" @click="closeTrashModal">Fechar</button>
        </div>
      </div>
    </div>

    <!-- SNIPPETS & CODE RECIPES CATALOG MODAL -->
    <div b-if="showSnippetsModal" class="trash-modal-backdrop snippets-modal-backdrop" @click="closeSnippetsModal">
      <div class="snippets-modal-card" @click="onModalCardClick">
        <div class="snippets-modal-header">
          <div class="snippets-header-left">
            <span class="snippets-header-icon">📚</span>
            <div>
              <div class="snippets-modal-title">Catálogo de Snippets & Receitas de Código</div>
              <div class="snippets-modal-sub">Templates prontos de Data Science, Machine Learning, Gráficos e Matemática Nativa em Object Pascal</div>
            </div>
          </div>
          <button class="trash-modal-close" @click="closeSnippetsModal" title="Fechar (Esc)">✕</button>
        </div>

        <!-- SEARCH & CATEGORY FILTER BAR -->
        <div class="snippets-toolbar-bar">
          <div class="snippets-search-wrap">
            <span class="snippets-search-icon">🔍</span>
            <input
              type="text"
              class="snippets-search-input"
              placeholder="Buscar receita por nome, pacote ou método (ex: CSV, Random Forest, Histograma, K-Means)..."
              :value="snippetSearchQuery"
              @input="onSnippetSearchInput($event)"
            />
          </div>
          <div class="snippets-category-pills">
            <button
              class="snippet-cat-pill"
              :class="{ 'cat-active': snippetCategory === 'all' }"
              @click="setSnippetCategory('all')"
            >
              ✨ Todas
            </button>
            <button
              class="snippet-cat-pill"
              :class="{ 'cat-active': snippetCategory === 'pandas' }"
              @click="setSnippetCategory('pandas')"
            >
              🐼 Pandas & Dados
            </button>
            <button
              class="snippet-cat-pill"
              :class="{ 'cat-active': snippetCategory === 'charts' }"
              @click="setSnippetCategory('charts')"
            >
              📊 Gráficos & EDA
            </button>
            <button
              class="snippet-cat-pill"
              :class="{ 'cat-active': snippetCategory === 'sklearn' }"
              @click="setSnippetCategory('sklearn')"
            >
              🤖 Machine Learning
            </button>
            <button
              class="snippet-cat-pill"
              :class="{ 'cat-active': snippetCategory === 'math' }"
              @click="setSnippetCategory('math')"
            >
              🧮 Matemática & Sistema
            </button>
          </div>
        </div>

        <!-- RECIPES GRID -->
        <div class="snippets-modal-body">
          <div b-if="filteredSnippetsCount === 0" class="trash-empty-state">
            Nenhuma receita encontrada para o filtro atual. Tente buscar outro termo ou selecione "✨ Todas".
          </div>

          <div class="snippets-grid">
            <div b-for="recipe in filteredSnippets" :key="recipe.id" class="snippet-card">
              <div class="snippet-card-top">
                <div class="snippet-title-row">
                  <span class="snippet-icon">{{ recipe.icon }}</span>
                  <span class="snippet-title">{{ recipe.title }}</span>
                  <span class="snippet-cat-badge" :class="'cat-badge-' + recipe.category">{{ recipe.categoryLabel }}</span>
                </div>
                <p class="snippet-desc">{{ recipe.description }}</p>
              </div>

              <pre class="snippet-code-preview">{{ recipe.code }}</pre>

              <div class="snippet-card-footer">
                <span class="snippet-unit-tag">📦 {{ recipe.unitTag }}</span>
                <div class="snippet-card-actions">
                  <button class="btn-snippet-insert" @click="insertSnippetRecipe(recipe, false)" title="Inserir como nova célula no notebook">
                    ➕ Inserir Célula
                  </button>
                  <button class="btn-snippet-run" @click="insertSnippetRecipe(recipe, true)" title="Inserir célula e executar imediatamente no Kernel">
                    ▶ Inserir & Executar
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="trash-modal-footer">
          <span class="snippets-footer-hint">💡 Dica: Todas as receitas inseridas suportam Desfazer (<code>Ctrl+Z</code>) e autocompletion.</span>
          <button class="tb-btn tb-btn-primary" @click="closeSnippetsModal">Fechar</button>
        </div>
      </div>
    </div>

    <!-- INFORMATIVE FOOTER -->
    <footer class="notebook-footer">
      <div class="footer-item">Total Cells: <strong>{{ cells.length }}</strong></div>
      <div class="footer-item">Executed: <strong>{{ executedCellsCount }}</strong></div>
      <div class="footer-item">License: <strong>Modified LGPL v2.1 (Free Pascal / Lazarus)</strong></div>
    </footer>
  </div>
</template>

<script>
  {
    BvNotebook.bv - Interactive Notebook Container & WebSocket Kernel Orchestrator
    Part of BlaiseNotebook Suite (Modified LGPL v2.1 with Linking Exception)
  }

  data:
    notebookName: string = 'scientific_analysis_pascal';
    kernelStatus: string = 'disconnected'; // 'connected', 'busy', 'disconnected'
    kernelUrl: string = 'ws://localhost:8090/ws';
    isRunning: boolean = false;
    isDashboardMode: boolean = false;
    canUndo: boolean = false;
    canRedo: boolean = false;
    trashCount: integer = 0;
    trashList: JSValue = [];
    showTrashModal: boolean = false;
    showOutlineDrawer: boolean = false;
    outlineItems: JSValue = [];
    outlineCount: integer = 0;
    showSnippetsModal: boolean = false;
    snippetSearchQuery: string = '';
    snippetCategory: string = 'all';
    snippetInsertTargetIdx: integer = -1;
    filteredSnippets: JSValue = [];
    filteredSnippetsCount: integer = 0;
    undoToastVisible: boolean = false;
    undoToastMessage: string = '';
    cells: JSValue = [];
    executionCounter: integer = 0;

  computed:
    function isKernelBusy: boolean;
    begin
      Result := (this['kernelStatus'] = 'busy');
    end;

    function executedCellsCount: integer;
    var
      c: Integer;
    begin
      asm
        const list = this.cells || [];
        c = 0;
        for (let i = 0; i < list.length; i++) {
          if (list[i].execution_count && list[i].execution_count > 0) c++;
        }
        return c;
      end;
    end;

    function kernelStatusText: string;
    var
      st: string;
    begin
      st := string(this['kernelStatus']);
      if st = 'connected' then
        Result := 'Kernel mORMot 2 Connected'
      else if st = 'busy' then
        Result := 'Kernel Running...'
      else
        Result := 'Standalone Mode (Active Simulator)';
    end;

    function kernelStatusClass: JSValue;
    var
      st: string;
    begin
      st := string(this['kernelStatus']);
      asm
        return {
          'status-connected': st === 'connected',
          'status-busy': st === 'busy',
          'status-disconnected': st === 'disconnected'
        };
      end;
    end;

  methods:
    procedure pushHistory(const ADesc: string);
    begin
      asm
        if (this._contentEditTimer) {
          clearTimeout(this._contentEditTimer);
          this._contentEditTimer = null;
        }
        if (!this._undoStack) this._undoStack = [];
        if (!this._redoStack) this._redoStack = [];

        // If there is an in-flight uncommitted edit session, push it first!
        if (this._editSnapshotPending && this._beforeEditSnapshot) {
          const editItem = new Object();
          editItem.description = 'Edição de código/texto';
          editItem.cells = this._beforeEditSnapshot;
          this._undoStack.push(editItem);
          this._editSnapshotPending = false;
          this._beforeEditSnapshot = null;
        }

        try {
          const snapshot = JSON.parse(JSON.stringify(this.cells || []));
          const histItem = new Object();
          histItem.description = ADesc || 'Alteração';
          histItem.cells = snapshot;
          this._undoStack.push(histItem);
          if (this._undoStack.length > 50) {
            this._undoStack.shift();
          }
          this._redoStack = [];
          this.canUndo = this._undoStack.length > 0;
          this.canRedo = false;
          setTimeout(() => { this.refreshOutline(); }, 10);
        } catch(err) {
          console.error('[BlaiseNotebook] pushHistory error:', err);
        }
      end;
    end;

    procedure onCellSourceChanged(payloadOrCell: JSValue; const ANewVal: string; const AOldVal: string);
    begin
      asm
        let targetCell = null;
        let newVal = '';
        let oldVal = undefined;

        if (payloadOrCell && typeof payloadOrCell === 'object' && payloadOrCell.cell !== undefined) {
          targetCell = payloadOrCell.cell;
          newVal = payloadOrCell.newVal !== undefined ? payloadOrCell.newVal : '';
          oldVal = payloadOrCell.oldVal;
        } else {
          targetCell = payloadOrCell;
          newVal = ANewVal !== undefined ? ANewVal : '';
          oldVal = AOldVal;
        }

        const rawCell = (targetCell && targetCell.__bv_raw__) ? targetCell.__bv_raw__ : targetCell;
        if (!rawCell) return;

        if (oldVal === undefined) {
          oldVal = rawCell.source;
        }

        if (newVal === oldVal && rawCell.source === newVal) return;

        // CRITICAL: Capture snapshot BEFORE applying the edit!
        if (!this._editSnapshotPending) {
          try {
            const snap = JSON.parse(JSON.stringify(this.cells || []));
            if (rawCell.id) {
              for (let i = 0; i < snap.length; i++) {
                if (snap[i].id === rawCell.id) {
                  snap[i].source = oldVal;
                  break;
                }
              }
            }
            this._beforeEditSnapshot = snap;
            this._editSnapshotPending = true;
          } catch(e) {
            console.error('[BlaiseNotebook] Snapshot error:', e);
          }
        }

        rawCell.source = newVal;
        this.refreshOutline();

        // Enable Undo and disable Redo for this new modification
        this.canUndo = true;
        this.canRedo = false;

        if (this._contentEditTimer) clearTimeout(this._contentEditTimer);
        const self = this;
        this._contentEditTimer = setTimeout(function() {
          if (self._editSnapshotPending && self._beforeEditSnapshot) {
            if (!self._undoStack) self._undoStack = [];
            const histItem = new Object();
            histItem.description = 'Edição de código/texto';
            histItem.cells = self._beforeEditSnapshot;
            self._undoStack.push(histItem);
            if (self._undoStack.length > 50) self._undoStack.shift();
            self._redoStack = [];
            self.canUndo = true;
            self.canRedo = false;
            self._editSnapshotPending = false;
            self._beforeEditSnapshot = null;
          }
        }, 500);
      end;
    end;

    procedure undoAction;
    begin
      asm
        if (this._contentEditTimer) {
          clearTimeout(this._contentEditTimer);
          this._contentEditTimer = null;
        }

        let targetPreviousCells = null;

        // 1. If currently in an active editing session, the previous state is _beforeEditSnapshot
        if (this._editSnapshotPending && this._beforeEditSnapshot) {
          targetPreviousCells = this._beforeEditSnapshot;
          this._editSnapshotPending = false;
          this._beforeEditSnapshot = null;
        } else if (this._undoStack && this._undoStack.length > 0) {
          const prev = this._undoStack.pop();
          targetPreviousCells = prev.cells;
        }

        if (!targetPreviousCells) return;

        try {
          if (!this._redoStack) this._redoStack = [];
          const currentSnapshot = JSON.parse(JSON.stringify(this.cells || []));
          const redoItem = new Object();
          redoItem.cells = currentSnapshot;
          this._redoStack.push(redoItem);

          // In-place property update on existing cell proxies so active components immediately reflect the change
          if (Array.isArray(this.cells) && Array.isArray(targetPreviousCells) && this.cells.length === targetPreviousCells.length) {
            for (let i = 0; i < this.cells.length; i++) {
              const curC = this.cells[i];
              const prevC = targetPreviousCells[i];
              if (curC && prevC && curC.id === prevC.id) {
                curC.source = prevC.source;
                curC.status = prevC.status;
                curC.outputs = prevC.outputs;
              }
            }
          }

          this.cells = targetPreviousCells;
          this.canUndo = (this._undoStack && this._undoStack.length > 0) || false;
          this.canRedo = (this._redoStack && this._redoStack.length > 0) || false;
          this.refreshOutline();
          if (typeof this.$forceUpdate === 'function') this.$forceUpdate();
        } catch(err) {
          console.error('[BlaiseNotebook] undoAction error:', err);
        }
      end;
    end;

    procedure redoAction;
    begin
      asm
        if (!this._redoStack || this._redoStack.length === 0) return;
        try {
          if (this._contentEditTimer) {
            clearTimeout(this._contentEditTimer);
            this._contentEditTimer = null;
          }
          if (!this._undoStack) this._undoStack = [];
          const currentSnapshot = JSON.parse(JSON.stringify(this.cells || []));
          const undoItem = new Object();
          undoItem.cells = currentSnapshot;
          this._undoStack.push(undoItem);

          const next = this._redoStack.pop();
          const targetNextCells = next.cells;

          // In-place property update on existing cell proxies so active components immediately reflect the change
          if (Array.isArray(this.cells) && Array.isArray(targetNextCells) && this.cells.length === targetNextCells.length) {
            for (let i = 0; i < this.cells.length; i++) {
              const curC = this.cells[i];
              const nxtC = targetNextCells[i];
              if (curC && nxtC && curC.id === nxtC.id) {
                curC.source = nxtC.source;
                curC.status = nxtC.status;
                curC.outputs = nxtC.outputs;
              }
            }
          }

          this.cells = targetNextCells;
          this.canUndo = this._undoStack.length > 0;
          this.canRedo = this._redoStack.length > 0;
          this._editSnapshotPending = false;
          this._beforeEditSnapshot = null;
          this.refreshOutline();
          if (typeof this.$forceUpdate === 'function') this.$forceUpdate();
        } catch(err) {
          console.error('[BlaiseNotebook] redoAction error:', err);
        }
      end;
    end;

    procedure restoreLastDeletedCell;
    begin
      asm
        if (!this._trashList || this._trashList.length === 0) return;
        this.pushHistory('Restaurar célula');
        const item = this._trashList.shift();
        this.trashList = this._trashList.slice();
        this.trashCount = this._trashList.length;
        this.undoToastVisible = false;
        if (this._toastTimer) clearTimeout(this._toastTimer);

        let targetIdx = item.originalIndex;
        if (targetIdx < 0) targetIdx = 0;
        if (targetIdx > this.cells.length) targetIdx = this.cells.length;

        this.cells.splice(targetIdx, 0, item.cell);
        this.cells = this.cells.slice();
        if (typeof this.$forceUpdate === 'function') this.$forceUpdate();

        setTimeout(() => {
          const el = document.querySelector('[data-cell-id="' + item.cell.id + '"]');
          if (el && typeof el.scrollIntoView === 'function') {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }, 60);
      end;
    end;

    procedure restoreTrashItem(const AId: string);
    begin
      asm
        if (!this._trashList || this._trashList.length === 0) return;
        const idx = this._trashList.findIndex(x => x && x.id === AId);
        if (idx < 0) return;
        this.pushHistory('Restaurar célula da lixeira');
        const item = this._trashList.splice(idx, 1)[0];
        this.trashList = this._trashList.slice();
        this.trashCount = this._trashList.length;

        let targetIdx = item.originalIndex;
        if (targetIdx < 0) targetIdx = 0;
        if (targetIdx > this.cells.length) targetIdx = this.cells.length;

        this.cells.splice(targetIdx, 0, item.cell);
        this.cells = this.cells.slice();
        if (typeof this.$forceUpdate === 'function') this.$forceUpdate();

        if (this.trashCount === 0) {
          this.showTrashModal = false;
        }

        setTimeout(() => {
          const el = document.querySelector('[data-cell-id="' + item.cell.id + '"]');
          if (el && typeof el.scrollIntoView === 'function') {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }, 60);
      end;
    end;

    procedure clearTrash;
    begin
      asm
        this._trashList = [];
        this.trashList = [];
        this.trashCount = 0;
        this.undoToastVisible = false;
        this.showTrashModal = false;
        if (typeof this.$forceUpdate === 'function') this.$forceUpdate();
      end;
    end;

    procedure openTrashModal;
    begin
      asm
        this.showTrashModal = true;
        if (typeof this.$forceUpdate === 'function') this.$forceUpdate();
      end;
    end;

    procedure closeTrashModal;
    begin
      asm
        this.showTrashModal = false;
        if (typeof this.$forceUpdate === 'function') this.$forceUpdate();
      end;
    end;

    procedure closeUndoToast;
    begin
      asm
        this.undoToastVisible = false;
        if (this._toastTimer) clearTimeout(this._toastTimer);
        if (typeof this.$forceUpdate === 'function') this.$forceUpdate();
      end;
    end;

    procedure onModalCardClick(e: JSValue);
    begin
      asm
        if (e && typeof e.stopPropagation === 'function') {
          e.stopPropagation();
        }
      end;
    end;
    procedure refreshOutline;
    begin
      asm
        const items = [];
        const list = this.cells || [];
        for (let i = 0; i < list.length; i++) {
          const c = list[i];
          if (!c) continue;
          const rawC = c.__bv_raw__ ? c.__bv_raw__ : c;
          if (rawC.type !== 'markdown') continue;
          const src = rawC.source || '';
          const lines = src.split('\n');
          let inCodeBlock = false;
          for (let l = 0; l < lines.length; l++) {
            const line = lines[l].trim();
            if (line.indexOf('```') === 0) {
              inCodeBlock = !inCodeBlock;
              continue;
            }
            if (inCodeBlock) continue;
            const m = line.match(/^(#{1,3})\s+(.+)$/);
            if (m) {
              const level = m[1].length;
              let titleText = m[2].trim()
                .replace(/\*\*([^*]+)\*\*/g, '$1')
                .replace(/\*([^*]+)\*/g, '$1')
                .replace(/`([^`]+)`/g, '$1');
              if (titleText) {
                items.push({
                  id: rawC.id + '_h_' + i + '_' + l,
                  cellId: rawC.id,
                  cellIndex: i,
                  lineIndex: l,
                  level: level,
                  badge: 'H' + level,
                  text: titleText
                });
              }
            }
          }
        }
        this.outlineItems = items;
        this.outlineCount = items.length;
      end;
    end;

    procedure toggleOutlineDrawer;
    begin
      asm
        this.showOutlineDrawer = !this.showOutlineDrawer;
        this.refreshOutline();
        if (typeof this.$forceUpdate === 'function') this.$forceUpdate();
      end;
    end;

    procedure scrollToOutlineItem(entry: JSValue);
    begin
      asm
        if (!entry) return;
        const rawEntry = entry.__bv_raw__ ? entry.__bv_raw__ : entry;
        const cellId = rawEntry.cellId;
        const idx = rawEntry.cellIndex;

        let targetEl = null;
        if (cellId) {
          targetEl = document.querySelector('[data-cell-id="' + cellId + '"]');
        }
        if (!targetEl && typeof idx === 'number') {
          targetEl = document.querySelector('[data-cell-index="' + idx + '"]');
        }

        if (targetEl && typeof targetEl.scrollIntoView === 'function') {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          const cellCard = targetEl.classList.contains('bv-cell-container')
            ? targetEl
            : (targetEl.querySelector('.bv-cell-container') || targetEl);
          cellCard.classList.remove('cell-outline-highlight');
          void cellCard.offsetWidth;
          cellCard.classList.add('cell-outline-highlight');
          setTimeout(() => {
            cellCard.classList.remove('cell-outline-highlight');
          }, 1500);
        }
      end;
    end;

    procedure initSnippetsCatalog;
