                    '  Writeln(\'[+] Invoking CPython 3.13 API via BlaisePyKernel...\');\n\n' +
                    '  PyCode :=\n' +
                    '    \'import pandas as pd, numpy as np\'#10 +\n' +
                    '    \'np.random.seed(42)\'#10 +\n' +
                    '    \'df = pd.DataFrame({\'#10 +\n' +
                    '    \'  "Iteration": [1, 2, 3, 4, 5, 6],\'#10 +\n' +
                    '    \'  "Train_Loss": [0.85, 0.62, 0.41, 0.28, 0.15, 0.08],\'#10 +\n' +
                    '    \'  "Accuracy": [0.65, 0.74, 0.83, 0.89, 0.95, 0.98]\'#10 +\n' +
                    '    \'})\'#10 +\n' +
                    '    \'print("[Python] DataFrame processed with", len(df), "iterations")\';\n\n' +
                    '  PyRun(PyCode);\n\n' +
                    '  // Display Pandas DataFrame as a responsive table in the notebook\n' +
                    '  ShowPyDataFrame(\'df\', \'AI Training History (Pandas)\', 10);\n\n' +
                    '  // Display model convergence curve with Chart.js\n' +
                    '  ShowChart(\n' +
                    '    \'Model Convergence (Accuracy vs Iteration)\',\n' +
                    '    \'line\',\n' +
                    '    \'{"labels":["Iter 1","Iter 2","Iter 3","Iter 4","Iter 5","Iter 6"],"datasets":[{"label":"Accuracy","data":[0.65,0.74,0.83,0.89,0.95,0.98],"borderColor":"#2563eb","backgroundColor":"rgba(37,99,235,0.15)","tension":0.3,"fill":true}]}\'\n' +
                    '  );\n' +
                    'end;',
            execution_count: 0,
            status: 'idle',
            execution_time_ms: 0,
            outputs: []
          }
