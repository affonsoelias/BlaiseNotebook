        if (cellOrIdx && typeof cellOrIdx === 'object' && cellOrIdx.id) {
          targetIdx = (this.cells || []).findIndex(x => x && x.id === cellOrIdx.id);
        } else if (typeof cellOrIdx === 'number') {
          targetIdx = cellOrIdx;
        }
        if (targetIdx < 0 || targetIdx >= this.cells.length) {
