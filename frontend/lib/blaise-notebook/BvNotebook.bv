    var
      newCell: JSValue;
    begin
      asm
        this.pushHistory('Adicionar célula de código');
        const c = (this.createCell || window.bvCreateCell)('code', '// New Object Pascal code block\n');
        this.cells.push(c);
      end;
    end;

