<template>
  <div class="bui-chart-wrapper" :style="{ width: width, height: height }">
    <canvas b-ref="chartCanvas"></canvas>
  </div>
</template>

<script>
  {
    BVChart - Unified Reactive Chart Component (Chart.js Powered)
    --------------------------------------------------------------
    Props:
    - type: String ('bar', 'line', 'pie', 'doughnut', 'radar', 'polarArea', 'scatter', 'bubble')
    - data: JSValue (Chart.js data object)
    - options: JSValue (Chart.js options object)
    - width: String (CSS width, default: '100%')
    - height: String (CSS height, default: '400px')
  }

  props:
    type: string = 'bar';
    data: JSValue = null;
    options: JSValue = null;
    width: string = '100%';
    height: string = '400px';

  data:
    _dummy: integer = 0;

  created:
    begin
       asm
         this._chart = null;
         this._pendingData = null;
         this._updatePending = false;
       end;
    end;

  methods:
    procedure initChart;
    begin
       asm
         const bv = (typeof window !== 'undefined' && window.__BV_CORE__) ? window.__BV_CORE__ : null;

         const runInit = () => {
           const canvas = this.$refs ? this.$refs.chartCanvas : null;
           if (!canvas) return;
           
           if (typeof Chart === 'undefined') {
             console.warn('[BVChart] Chart.js is not loaded.');
             return;
           }

           function destroySafely(c) {
             if (!c) return;
             try {
               c._doResize = function() { return 0; };
               c.update = function() {};
               c.render = function() {};
               c.draw = function() {};
               c.destroy();
             } catch(e) {}
           }

           const existingChart = Chart.getChart(canvas);
           if (existingChart) destroySafely(existingChart);
           if (this._chart) destroySafely(this._chart);
           this._chart = null;

           function extractData(input) {
             if (!input) return null;
             if (typeof input.ToJS === 'function') return input.ToJS();
             if (typeof input.toJS === 'function') return input.toJS();
             if (input.FJS) return input.FJS;
             return input;
           }

           function cloneChartData(input, chartType) {
             if (!input) return null;
             const raw = (bv && bv.unproxy) ? bv.unproxy(input) : input;
             if (!raw) return null;
             const isRadial = (chartType === 'pie' || chartType === 'doughnut' || chartType === 'polarArea');
             const defaultPalette = ['#10b981', '#3b82f6', '#f59e0b', '#8b5cf6', '#ec4899', '#06b6d4', '#6366f1'];
             return {
               labels: Array.isArray(raw.labels) ? [...raw.labels] : [],
               datasets: Array.isArray(raw.datasets) ? raw.datasets.map(ds => {
                 const copy = Object.assign({}, ds);
                 if (Array.isArray(ds.data)) copy.data = [...ds.data];
                 if (Array.isArray(ds.backgroundColor)) copy.backgroundColor = [...ds.backgroundColor];
                 if (Array.isArray(ds.borderColor)) copy.borderColor = [...ds.borderColor];
                 if (isRadial && Array.isArray(copy.data) && (!copy.backgroundColor || typeof copy.backgroundColor === 'string')) {
                   copy.backgroundColor = copy.data.map((_, idx) => defaultPalette[idx % defaultPalette.length]);
                   copy.borderColor = '#ffffff';
                 }
                 return copy;
               }) : []
             };
           }

           const rawData = extractData(this.data);
           if (!rawData || !rawData.datasets) return;
           
           try {
             const chartData = cloneChartData(rawData, this.type);
             const rawOpts = extractData(this.options);
            function applyChartTheme(opts, isRadialChart) {
              const res = opts ? Object.assign({}, opts) : {};
              if (res.responsive === undefined) res.responsive = true;
              if (res.maintainAspectRatio === undefined) res.maintainAspectRatio = false;
              if (res.resizeDelay === undefined) res.resizeDelay = 50;

              if (!isRadialChart) {
                if (!res.scales) res.scales = {};
                if (!res.scales.x) res.scales.x = {};
                if (!res.scales.y) res.scales.y = {};

                if (!res.scales.x.ticks) res.scales.x.ticks = {};
                if (res.scales.x.ticks.color === undefined) res.scales.x.ticks.color = '#8b949e';
                if (res.scales.x.ticks.padding === undefined) res.scales.x.ticks.padding = 6;
                if (!res.scales.x.grid) res.scales.x.grid = {};
                if (res.scales.x.grid.color === undefined) res.scales.x.grid.color = 'rgba(255, 255, 255, 0.08)';

                if (!res.scales.y.ticks) res.scales.y.ticks = {};
                if (res.scales.y.ticks.color === undefined) res.scales.y.ticks.color = '#8b949e';
                if (res.scales.y.ticks.padding === undefined) res.scales.y.ticks.padding = 6;
                if (!res.scales.y.grid) res.scales.y.grid = {};
                if (res.scales.y.grid.color === undefined) res.scales.y.grid.color = 'rgba(255, 255, 255, 0.08)';
              } else if (res.scales) {
                delete res.scales;
              }

              if (!res.layout) {
                res.layout = { padding: { top: 8, right: 14, bottom: 20, left: 8 } };
              } else if (typeof res.layout.padding === 'number') {
                const p = res.layout.padding;
                res.layout.padding = { top: p, right: p, bottom: p + 20, left: p };
              } else if (typeof res.layout.padding === 'object') {
                if (res.layout.padding.bottom === undefined) {
                  res.layout.padding.bottom = 20;
                } else {
                  res.layout.padding.bottom = Math.max(res.layout.padding.bottom, 20);
                }
              }

              if (!res.plugins) res.plugins = {};
              if (!res.plugins.legend) res.plugins.legend = {};
              if (!res.plugins.legend.labels) res.plugins.legend.labels = {};
              if (res.plugins.legend.labels.color === undefined) {
                res.plugins.legend.labels.color = '#c9d1d9';
              }
              return res;
            }

            const isRadial = (this.type === 'pie' || this.type === 'doughnut' || this.type === 'polarArea');
            const rawParsed = rawOpts ? ((bv && bv.unproxy) ? bv.unproxy(rawOpts) : rawOpts) : {};
            let finalOpts = applyChartTheme(rawParsed, isRadial);
             if (!finalOpts.onClick) {
               finalOpts.onClick = (event, elements) => {
                 if (elements && elements.length > 0) {
                   const el = elements[0];
                   const dsIndex = el.datasetIndex;
                   const index = el.index;
                   const ds = chartData.datasets ? chartData.datasets[dsIndex] : null;
                   const label = chartData.labels ? chartData.labels[index] : '';
                   const val = ds && ds.data ? ds.data[index] : null;
                   this.$emit('chart-click', {
                     datasetIndex: dsIndex,
                     index: index,
                     label: label,
                     value: val,
                     datasetLabel: ds ? ds.label : ''
                   });
                 }
               };
             }

             this._chart = new Chart(canvas, {
               type: this.type || 'bar',
               data: chartData,
               options: finalOpts
             });
           } catch (e) {
             console.error('[BVChart] Failed to initialize chart:', e);
           }
         };

         if (bv && typeof bv.nonReactive === 'function') {
           bv.nonReactive(runInit);
         } else {
           runInit();
         }
       end;
    end;

  mounted:
    begin
      asm this.initChart(); end;
    end;

  watch:
    procedure data(newVal: JSValue);
    begin
       asm
         this._pendingData = newVal;
         if (this._updatePending) return;
         this._updatePending = true;

         requestAnimationFrame(() => {
           this._updatePending = false;
           const dataToUse = this._pendingData;
           if (!this._chart || !this._chart.canvas || !dataToUse) {
             this.initChart();
             return;
           }

           function cloneChartData(input, chartType) {
             if (!input) return null;
             const raw = (window.__BV_CORE__ && window.__BV_CORE__.unproxy) ? window.__BV_CORE__.unproxy(input) : input;
             if (!raw) return null;
             const isRadial = (chartType === 'pie' || chartType === 'doughnut' || chartType === 'polarArea');
             const defaultPalette = ['#10b981', '#3b82f6', '#f59e0b', '#8b5cf6', '#ec4899', '#06b6d4', '#6366f1'];
             return {
               labels: Array.isArray(raw.labels) ? [...raw.labels] : [],
               datasets: Array.isArray(raw.datasets) ? raw.datasets.map(ds => {
                 const copy = Object.assign({}, ds);
                 if (Array.isArray(ds.data)) copy.data = [...ds.data];
                 if (Array.isArray(ds.backgroundColor)) copy.backgroundColor = [...ds.backgroundColor];
                 if (Array.isArray(ds.borderColor)) copy.borderColor = [...ds.borderColor];
                 if (isRadial && Array.isArray(copy.data) && (!copy.backgroundColor || typeof copy.backgroundColor === 'string')) {
                   copy.backgroundColor = copy.data.map((_, idx) => defaultPalette[idx % defaultPalette.length]);
                   copy.borderColor = '#ffffff';
                 }
                 return copy;
               }) : []
             };
           }

           try {
             const rawNewData = cloneChartData(dataToUse, this.type);
             if (!rawNewData || !rawNewData.datasets) return;

             if (rawNewData.labels) {
               this._chart.data.labels = rawNewData.labels;
             }

             const curDatasets = this._chart.data.datasets;
             if (curDatasets && curDatasets.length === rawNewData.datasets.length) {
               for (let i = 0; i < rawNewData.datasets.length; i++) {
                 const target = curDatasets[i];
                 const source = rawNewData.datasets[i];
                 if (source.data) target.data = source.data;
                 if (source.backgroundColor !== undefined) target.backgroundColor = source.backgroundColor;
                 if (source.borderColor !== undefined) target.borderColor = source.borderColor;
                 if (source.label !== undefined) target.label = source.label;
                 if (source.fill !== undefined) target.fill = source.fill;
                 if (source.tension !== undefined) target.tension = source.tension;
                 if (source.pointRadius !== undefined) target.pointRadius = source.pointRadius;
                 if (source.pointHoverRadius !== undefined) target.pointHoverRadius = source.pointHoverRadius;
               }
             } else {
               this._chart.data.datasets = rawNewData.datasets;
             }

             this._chart.update();
           } catch (e) {
             console.warn('[BVChart] Hot update failed, falling back to full re-init:', e);
             this.initChart();
           }
         });
       end;
    end;

    procedure options(newVal: JSValue);
    begin
       asm
         if (this._chart && this._chart.canvas && newVal) {
           try {
             const rawNewOpts = (window.__BV_CORE__ && window.__BV_CORE__.unproxy) ? window.__BV_CORE__.unproxy(newVal) : newVal;
             const isRadial = (this.type === 'pie' || this.type === 'doughnut' || this.type === 'polarArea');
             const themedOpts = (typeof applyChartTheme === 'function') ? applyChartTheme(rawNewOpts, isRadial) : rawNewOpts;
             this._chart.options = themedOpts;
             this._chart.update();
           } catch (e) {
             this.initChart();
           }
         }
       end;
    end;

    procedure type(newVal: string);
    begin
      asm
        this.initChart();
      end;
    end;
</script>

<style>
  .bui-chart-wrapper {
    position: relative;
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    margin-bottom: 0;
    background: transparent;
    overflow: visible;
  }

  .bui-chart-wrapper canvas {
    display: block;
    box-sizing: border-box;
    width: 100% !important;
    max-width: 100%;
  }
</style>
