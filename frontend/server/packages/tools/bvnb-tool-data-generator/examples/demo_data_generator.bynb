    {
      "id": "cell_1",
      "type": "markdown",
      "source": "# 📊 Synthetic Dataset Generator\nUsing the official `uDataGenerator` tool to synthesize data points directly in Pascal.",
      "execution_count": 0,
      "status": "idle",
      "execution_time_ms": 0,
      "outputs": []
    },
    {
      "id": "cell_2",
      "type": "code",
      "source": "uses\n  BlaiseOutput,\n  uDataGenerator;\n\nvar\n  X, Y: TDoubleArray;\n  i: Integer;\nbegin\n  GenerateLinearDataset(5, 3.0, 1.5, 0.2, X, Y);\n  Writeln('[+] Generated 5 synthetic samples:');\n  for i := 0 to High(X) do\n    Writeln('  X = ', X[i]:0:2, ' -> Y = ', Y[i]:0:2);\nend;",
      "execution_count": 0,
      "status": "idle",
      "execution_time_ms": 0,
      "outputs": []
    }
  ]
}
