<template>
  <div translate="no" class="notranslate">
    <!-- RESPONSIVE DRAWER (PROJECT MENU) -->
    <bv-drawer ref="appDrawer" title="📐 BlaiseNotebook">
      <div class="drawer-nav">
        <!-- SECTION: PROJECT & FILES -->
        <div class="drawer-section-title">📁 PROJECT & FILES</div>
        <button class="drawer-item-btn" type="button" @click="onNewProject">
          <span class="d-icon">🆕</span>
          <span class="d-text">New Notebook</span>
          <span class="d-shortcut">Alt+N</span>
        </button>
        <button class="drawer-item-btn" type="button" @click="onOpenProject">
          <span class="d-icon">📂</span>
          <span class="d-text">Open Notebook (.bynb)...</span>
          <span class="d-shortcut">Ctrl+O</span>
        </button>
        <button class="drawer-item-btn" type="button" @click="onSaveProject">
          <span class="d-icon">💾</span>
          <span class="d-text">Save Notebook (.bynb)</span>
          <span class="d-shortcut">Ctrl+S</span>
        </button>
        <button class="drawer-item-btn" type="button" @click="onSaveProjectAs">
          <span class="d-icon">📑</span>
          <span class="d-text">Save As...</span>
        </button>
        <button class="drawer-item-btn" type="button" @click="onExportPascal">
          <span class="d-icon">📤</span>
          <span class="d-text">Export Pascal Code (.pas)</span>
        </button>
        <button class="drawer-item-btn drawer-item-danger" type="button" @click="onCloseProject">
          <span class="d-icon">🚪</span>
          <span class="d-text">Close / Exit Project</span>
        </button>

        <div class="drawer-divider"></div>

        <!-- SECTION: KERNEL & EXECUTION -->
        <div class="drawer-section-title">⚡ KERNEL & EXECUTION</div>
        <button class="drawer-item-btn drawer-item-primary" type="button" @click="onRunAll">
          <span class="d-icon">▶▶</span>
          <span class="d-text">Run All Cells</span>
        </button>
        <button class="drawer-item-btn drawer-item-warning" type="button" @click="onInterruptAll">
          <span class="d-icon">⏹</span>
          <span class="d-text">Interrupt Execution</span>
          <span class="d-shortcut">Esc</span>
        </button>
        <button class="drawer-item-btn" type="button" @click="onRestartKernel">
          <span class="d-icon">🔄</span>
          <span class="d-text">Restart Kernel</span>
        </button>
        <button class="drawer-item-btn" type="button" @click="onClearOutputs">
          <span class="d-icon">🧹</span>
          <span class="d-text">Clear All Outputs</span>
        </button>

        <div class="drawer-divider"></div>

        <!-- SECTION: SHORTCUTS & INFO -->
        <div class="drawer-section-title">ℹ️ SHORTCUTS & ENVIRONMENT</div>
        <div class="drawer-info-box">
          <div class="info-line"><span>Run cell:</span> <code>Shift + Enter</code></div>
          <div class="info-line"><span>Run in-place:</span> <code>Ctrl + Enter</code></div>
          <div class="info-line"><span>Add code cell:</span> <code>Alt + C</code></div>
          <div class="info-line"><span>Environment:</span> <strong>FPC 3.2.2 + mORMot 2</strong></div>
          <div class="info-line"><span>AI / Python:</span> <strong>Python4Delphi 3.13</strong></div>
        </div>
      </div>
    </bv-drawer>

    <!-- MAIN APPLICATION NAVBAR -->
    <nav class="navbar">
      <div style="display: flex; align-items: center; gap: 8px;">
        <button class="drawer-btn" type="button" @click="toggleDrawer" title="Project Menu (Open, Save, Exit)">☰</button>
        <span style="font-size: 24px;">📐</span>
        <strong class="brand">BlaiseNotebook</strong>
      </div>

      <div class="theme-switcher">
        <button class="theme-toggle-btn" type="button" @click="toggleTheme" :title="isDark ? 'Switch to Light Mode' : 'Switch to Dark Mode'">
          <span b-if="isDark">☀️</span>
          <span b-if="!isDark">🌙</span>
        </button>
      </div>

      <span class="nav-msg">{{ mensagem }}</span>
    </nav>

    <!-- MAIN NOTEBOOK CANVAS CONTAINER -->
    <div class="notebook-main-canvas-wrapper">
      <bv-notebook></bv-notebook>
    </div>

    <!-- PERSISTENT FOOTER -->
    <div class="footer-status desktop-only-footer">
       📐 <strong>BlaiseNotebook v1.0</strong> | Object Pascal + Synopse mORMot 2 + Python4Delphi | License: <strong>Modified LGPL v2.1 (with Static Linking Exception)</strong> | Theme: <strong>{{ currentThemeName }}</strong>
    </div>
  </div>
</template>

<script>
  {
    App.bv - Root Application Component for BlaiseNotebook
    Part of BlaiseNotebook Suite (Modified LGPL v2.1 with Linking Exception)
  }

  data:
    mensagem: string = 'Data Science & AI in Object Pascal';
    isDark: boolean = false;

  provide:
    begin
      Result := TJSObject.new;
      Result['getAmbiente'] := function(): TJSObject
        begin
           Result := TJSObject.new;
           Result['id'] := 42;
           Result['status'] := 'BlaiseNotebook Active 🚀';
        end;
    end;

  computed:
    function currentThemeName: string;
    begin
      if this['isDark'] then
        Result := 'DARK (DARKLY)'
      else
        Result := 'LIGHT (FLATLY)';
    end;

  created:
    begin
      TJSObject(this['$store'])['appVersion'] := '1.0.0-SCIENTIFIC';
      TJSObject(this['$store'])['user'] := 'Pascal Scientist 🔬';
      asm
        if (typeof document !== 'undefined') document.title = 'BlaiseNotebook';
        let saved = null;
        try {
          if (window.localStorage) {
            saved = window.localStorage.getItem('bv_theme');
          }
        } catch(e) {}
        const themeToSet = saved || 'flatly';
        if (window.$theme && typeof window.$theme.setTheme === 'function') {
          window.$theme.setTheme(themeToSet);
          this.isDark = (window.$theme.isDark === true);
        } else {
          this.isDark = (themeToSet === 'darkly');
        }
      end;
    end;

  methods:
    procedure toggleDrawer;
    begin
      TriggerRef(this, 'appDrawer', 'toggle');
    end;

    procedure closeDrawer;
    begin
      TriggerRef(this, 'appDrawer', 'close');
    end;

    procedure toggleTheme;
    begin
      asm
        const nextDark = !this.isDark;
        this.isDark = nextDark;

        if (window.$theme && typeof window.$theme.setTheme === 'function') {
          window.$theme.setTheme(nextDark ? 'darkly' : 'flatly');
        } else {
          // Manual fallback if $theme not loaded
          const thName = nextDark ? 'darkly' : 'flatly';
          let link = document.getElementById('bv-theme');
          if (link) link.href = 'lib/themes/' + thName + '.min.css';
          try {
            if (window.localStorage) window.localStorage.setItem('bv_theme', thName);
          } catch(e) {}
        }

        // Apply HTML classes and data attributes for instant CSS reactivity
        if (document.documentElement) {
          document.documentElement.setAttribute('data-bs-theme', nextDark ? 'dark' : 'light');
          if (nextDark) {
            document.documentElement.classList.add('theme-dark');
            document.documentElement.classList.remove('theme-light');
            if (document.body) {
              document.body.classList.add('theme-dark');
              document.body.classList.remove('theme-light');
            }
          } else {
            document.documentElement.classList.add('theme-light');
            document.documentElement.classList.remove('theme-dark');
            if (document.body) {
              document.body.classList.add('theme-light');
              document.body.classList.remove('theme-dark');
            }
          }
        }
        if (typeof this.$forceUpdate === 'function') this.$forceUpdate();
      end;
    end;

    { Dispatches project menu events to BvNotebook }
    procedure onNewProject;
    begin
      asm
        window.dispatchEvent(new CustomEvent('blaise:new-project'));
      end;
      this.closeDrawer();
    end;

    procedure onOpenProject;
    begin
      asm
        window.dispatchEvent(new CustomEvent('blaise:open-project'));
      end;
      this.closeDrawer();
    end;

    procedure onSaveProject;
    begin
      asm
        window.dispatchEvent(new CustomEvent('blaise:save-project'));
      end;
      this.closeDrawer();
    end;

    procedure onSaveProjectAs;
    begin
      asm
        window.dispatchEvent(new CustomEvent('blaise:save-as'));
      end;
      this.closeDrawer();
    end;

    procedure onExportPascal;
    begin
      asm
        window.dispatchEvent(new CustomEvent('blaise:export-pascal'));
      end;
      this.closeDrawer();
    end;

    procedure onCloseProject;
    begin
      asm
        window.dispatchEvent(new CustomEvent('blaise:close-project'));
      end;
      this.closeDrawer();
    end;

    procedure onRunAll;
    begin
      asm
        window.dispatchEvent(new CustomEvent('blaise:run-all'));
      end;
      this.closeDrawer();
    end;

    procedure onInterruptAll;
    begin
      asm
        window.dispatchEvent(new CustomEvent('blaise:interrupt-all'));
      end;
      this.closeDrawer();
    end;

    procedure onRestartKernel;
    begin
      asm
        window.dispatchEvent(new CustomEvent('blaise:restart-kernel'));
      end;
      this.closeDrawer();
    end;

    procedure onClearOutputs;
    begin
      asm
        window.dispatchEvent(new CustomEvent('blaise:clear-outputs'));
      end;
      this.closeDrawer();
    end;

  mounted:
    begin
      asm
        if (typeof document !== 'undefined') document.title = 'BlaiseNotebook';
        const self = this;
        setTimeout(function() {
          if (typeof document !== 'undefined') document.title = 'BlaiseNotebook';
          if (window.$theme) {
            self.isDark = (window.$theme.isDark === true);
          } else {
            const attr = document.documentElement ? document.documentElement.getAttribute('data-bs-theme') : null;
            self.isDark = (attr === 'dark');
          }
          // Remove floating DevTools debug panel
        const killDt = function() {
          const els = document.querySelectorAll('.bv-devtools-panel');
          els.forEach(function(el) { if (el && el.parentNode) el.parentNode.removeChild(el); });
        };
        killDt();
        setTimeout(killDt, 50);
        setTimeout(killDt, 250);
        if (self.isDark) {
            document.documentElement.setAttribute('data-bs-theme', 'dark');
            document.documentElement.classList.add('theme-dark');
            if (document.body) document.body.classList.add('theme-dark');
          }
          if (typeof self.$forceUpdate === 'function') self.$forceUpdate();
        }, 30);
      end;
    end;
</script>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: #f8fafc;
    color: #1e293b;
    transition: background-color 0.2s, color 0.2s;
  }
  .navbar {
    background: #0f172a;
    padding: 10px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    border-bottom: 1px solid #1e293b;
  }
  .brand { color: #10b981; font-size: 19px; font-weight: 700; letter-spacing: -0.3px; }
  .theme-switcher { display: flex; align-items: center; margin-left: auto; }
  .theme-toggle-btn {
    background: rgba(255,255,255,0.08);
    color: #ecf0f1;
    border: 1px solid rgba(255,255,255,0.2);
    padding: 6px 12px;
    font-size: 15px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .theme-toggle-btn:hover {
    background: rgba(255,255,255,0.2);
    border-color: #10b981;
    transform: scale(1.05);
  }
  .drawer-btn { background: rgba(255,255,255,0.12); color: #ecf0f1; border: 1px solid rgba(255,255,255,0.25); border-radius: 4px; padding: 5px 10px; font-size: 16px; cursor: pointer; transition: background 0.2s; }
  .drawer-btn:hover { background: rgba(255,255,255,0.25); }

  /* Drawer Menu Styles */
  .drawer-nav { display: flex; flex-direction: column; gap: 4px; padding: 10px 4px 20px 4px; }
  .drawer-section-title { font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; padding: 10px 12px 4px 12px; }
  .drawer-item-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 14px;
    color: #334155;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .drawer-item-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
  }
  .drawer-item-primary {
    color: #059669;
    font-weight: 600;
  }
  .drawer-item-primary:hover {
    background: rgba(16, 185, 129, 0.12);
    color: #047857;
  }
  .drawer-item-warning {
    color: #d97706;
  }
  .drawer-item-warning:hover {
    background: #fef3c7;
    color: #b45309;
  }
  .drawer-item-danger {
    color: #e11d48;
  }
  .drawer-item-danger:hover {
    background: #ffe4e6;
    color: #be123c;
  }
  .d-icon { font-size: 16px; flex-shrink: 0; }
  .d-text { flex: 1; }
  .d-shortcut {
    font-size: 10.5px;
    background: rgba(0,0,0,0.05);
    color: #64748b;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
  }
  .drawer-divider {
    height: 1px;
    background: #e2e8f0;
    margin: 8px 4px;
  }
  .drawer-info-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 10px 12px;
    margin: 6px 4px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11.5px;
    color: #64748b;
  }
  .drawer-info-box .info-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .drawer-info-box code {
    background: #e2e8f0;
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 10.5px;
    color: #0f172a;
  }
  .drawer-info-box strong {
    color: #059669;
  }

  .nav-msg { color: #94a3b8; font-size: 12px; margin-left: 12px; }
  .notebook-main-canvas-wrapper { width: 100%; min-height: calc(100vh - 80px); padding-bottom: 40px; }
  @media (max-width: 768px) {
    .desktop-only-footer { display: none; }
    .notebook-main-canvas-wrapper { padding-bottom: 75px; }
  }
  .footer-status {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #0f172a;
    color: #94a3b8;
    font-size: 11px;
    padding: 4px 12px;
    text-align: right;
    border-top: 1px solid #1e293b;
    z-index: 100;
  }
  .footer-status strong { color: #10b981; }

  /* Hide DevTools Debug Floating Panel */
  .bv-devtools-panel {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  /* Dark Mode Integration */
  html[data-bs-theme="dark"] body,
  html.theme-dark body,
  body.theme-dark {
    background: #090d16 !important;
    color: #e2e8f0 !important;
  }
  html[data-bs-theme="dark"] .drawer-item-btn,
  html.theme-dark .drawer-item-btn {
    color: #cbd5e1;
  }
  html[data-bs-theme="dark"] .drawer-item-btn:hover,
  html.theme-dark .drawer-item-btn:hover {
    background: #1e293b;
    color: #ffffff;
  }
  html[data-bs-theme="dark"] .drawer-divider,
  html.theme-dark .drawer-divider {
    background: #334155;
  }
  html[data-bs-theme="dark"] .drawer-info-box,
  html.theme-dark .drawer-info-box {
    background: #0f172a;
    border-color: #334155;
    color: #94a3b8;
  }
  html[data-bs-theme="dark"] .drawer-info-box code,
  html.theme-dark .drawer-info-box code {
    background: #1e293b;
    color: #e2e8f0;
  }
</style>
