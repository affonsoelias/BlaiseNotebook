<template>
  <div class="bv-markdown-root" :class="{ 'bv-md-editing': isEditing }">
    <div class="bv-md-header">
      <div class="bv-md-badge">
        <span class="md-icon">📝</span>
        <span class="md-text">Documentação / Markdown</span>
      </div>
      <div class="bv-md-actions">
        <button b-if="!isEditing" class="bv-md-btn" @click="startEdit">✏️ Editar (Duplo Clique)</button>
        <button b-if="isEditing" class="bv-md-btn btn-save" @click="finishEdit">👁️ Concluir Edição (Ctrl+Enter)</button>
      </div>
    </div>

    <!-- MODO VISUALIZAÇÃO -->
    <div
      b-if="!isEditing"
      b-ref="renderedDiv"
      class="bv-md-rendered"
      @dblclick="startEdit"
    ></div>

    <!-- MODO EDIÇÃO -->
    <div b-if="isEditing" class="bv-md-editor-wrap">
      <textarea
        b-ref="mdTextarea"
        class="bv-md-textarea"
        placeholder="# Digite seu Markdown aqui..."
        @input="handleInput"
        @keydown="handleKeyDown"
      ></textarea>
      <div class="bv-md-editor-hint">
        Dica: Suporta títulos (#, ##), listas (-), negrito (**), código (`) e blocos de equações. Pressione <code>Ctrl + Enter</code> para renderizar.
      </div>
    </div>
  </div>
</template>

<script>
  {
    BvMarkdown.bv - Markdown Rendering & Inline Editor
    Part of BlaiseNotebook Suite (Modified LGPL v2.1 with Linking Exception)
  }

  props:
    value: string = '# Título da Seção\nEscreva a documentação do seu experimento ou análise científica aqui.';
    editable: boolean = true;

  data:
    isEditing: boolean = false;

  computed:
    function renderedHtml: string;
    var
      raw: string;
    begin
      asm
        const text = this.value || '';
        if (!text.trim()) {
          return '<p class="bv-md-empty"><em>(Célula de documentação vazia. Dê duplo clique para editar.)</em></p>';
        }

        // Basic clean parser for Markdown:
        let html = text
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');

        // Code blocks: ```...```
        html = html.replace(/```([a-zA-Z0-9_-]*)\n([\s\S]*?)```/g, function(match, lang, code) {
          return '<pre class="bv-md-pre"><code class="lang-' + lang + '">' + code.trim() + '</code></pre>';
        });

        // Inline code: `...`
        html = html.replace(/`([^`]+)`/g, '<code class="bv-md-code">$1</code>');

        // Headers
        html = html.replace(/^### (.*$)/gim, '<h3 class="bv-md-h3">$1</h3>');
        html = html.replace(/^## (.*$)/gim, '<h2 class="bv-md-h2">$1</h2>');
        html = html.replace(/^# (.*$)/gim, '<h1 class="bv-md-h1">$1</h1>');

        // Bold & Italic
        html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/\*([^*]+)\*/g, '<em>$1</em>');

        // Blockquotes
        html = html.replace(/^\> (.*$)/gim, '<blockquote class="bv-md-quote">$1</blockquote>');

        // Bullet lists
        html = html.replace(/^\- (.*$)/gim, '<li class="bv-md-li">$1</li>');
        html = html.replace(/(<li class="bv-md-li">[\s\S]*?<\/li>)/gim, '<ul class="bv-md-ul">$1</ul>');

        // Math/Formula markers: $$...$$ and $...$
        html = html.replace(/\$\$([\s\S]*?)\$\$/g, '<div class="bv-md-math-block">🧮 <code>$1</code></div>');
        html = html.replace(/\$([^$]+)\$/g, '<span class="bv-md-math-inline"><code>$1</code></span>');

        // Links: [text](url)
        html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="bv-md-link">$1</a>');

        // Line breaks (convert non-tag breaks to <br> or wrap in <p>)
        const lines = html.split('\n');
        let out = '';
        for (let i = 0; i < lines.length; i++) {
          const l = lines[i].trim();
          if (!l) continue;
          if (l.startsWith('<h') || l.startsWith('<pre') || l.startsWith('<ul') || l.startsWith('<blockquote') || l.startsWith('<div')) {
            out += l;
          } else {
            out += '<p class="bv-md-p">' + l + '</p>';
          }
        }
        return out;
      end;
    end;

  methods:
    procedure renderHtmlContent;
    begin
      asm
        const self = this;
        setTimeout(function() {
          const el = self.$refs ? self.$refs.renderedDiv : null;
          if (el) {
            el.innerHTML = self.renderedHtml;
          }
        }, 10);
      end;
    end;

    procedure startEdit;
    begin
      this['isEditing'] := true;
      asm
        const self = this;
        setTimeout(function() {
          const ta = self.$refs ? self.$refs.mdTextarea : null;
          if (ta) {
            ta.value = self.value || '';
            ta.focus();
            ta.style.height = 'auto';
            ta.style.height = Math.max(100, ta.scrollHeight) + 'px';
          }
        }, 50);
      end;
    end;

    procedure finishEdit;
    begin
      this['isEditing'] := false;
      asm
        this.renderHtmlContent();
        if (this.$emit) this.$emit('change', this.value);
      end;
    end;

    procedure handleInput(e: JSValue);
    begin
      asm
        const target = e && e.target ? e.target : null;
        if (target) {
          this.value = target.value;
          target.style.height = 'auto';
          target.style.height = Math.max(100, target.scrollHeight) + 'px';
          if (this.$emit) this.$emit('input', this.value);
        }
      end;
    end;

    procedure handleKeyDown(e: JSValue);
    begin
      asm
        const evt = e || window.event;
        if (!evt) return;
        if (evt.key === 'Enter' && (evt.ctrlKey || evt.metaKey)) {
          evt.preventDefault();
          this.finishEdit();
        }
      end;
    end;

  mounted:
    begin
      asm
        this.renderHtmlContent();
      end;
    end;

  watch:
    value:
      begin
        asm
          this.renderHtmlContent();
        end;
      end;
</script>

<style>
  .bv-markdown-root {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .bv-markdown-root:hover {
    border-color: #cbd5e1;
  }

  .bv-md-editing {
    border-color: #3b82f6 !important;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
  }

  .bv-md-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f8fafc;
    padding: 6px 12px;
    border-bottom: 1px solid #f1f5f9;
    font-size: 11.5px;
  }

  .bv-md-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #64748b;
    font-weight: 500;
  }

  .bv-md-actions {
    display: flex;
    gap: 6px;
  }

  .bv-md-btn {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    color: #475569;
    cursor: pointer;
    transition: all 0.15s;
  }

  .bv-md-btn:hover {
    background: #f1f5f9;
    color: #1e293b;
  }

  .btn-save {
    background: #3b82f6;
    color: #ffffff;
    border-color: #2563eb;
    font-weight: 600;
  }

  .btn-save:hover {
    background: #2563eb;
    color: #ffffff;
  }

  .bv-md-rendered {
    padding: 16px 20px;
    cursor: pointer;
    min-height: 50px;
    line-height: 1.6;
    color: #1e293b;
    font-size: 14px;
  }

  .bv-md-h1 {
    font-size: 22px;
    margin-bottom: 12px;
    color: #0f172a;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 6px;
  }

  .bv-md-h2 {
    font-size: 18px;
    margin-top: 14px;
    margin-bottom: 8px;
    color: #1e293b;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 4px;
  }

  .bv-md-h3 {
    font-size: 15px;
    margin-top: 10px;
    margin-bottom: 6px;
    color: #334155;
  }

  .bv-md-p {
    margin-bottom: 8px;
  }

  .bv-md-quote {
    border-left: 4px solid #10b981;
    padding: 8px 14px;
    background: #f0fdf4;
    color: #166534;
    border-radius: 0 6px 6px 0;
    margin: 10px 0;
    font-style: italic;
  }

  .bv-md-ul {
    padding-left: 24px;
    margin-bottom: 10px;
  }

  .bv-md-li {
    margin-bottom: 4px;
  }

  .bv-md-pre {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: 12px;
    border-radius: 6px;
    overflow-x: auto;
    font-family: monospace;
    font-size: 12.5px;
    margin: 10px 0;
  }

  .bv-md-code {
    background: #f1f5f9;
    color: #0f172a;
    padding: 2px 5px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 12.5px;
    border: 1px solid #e2e8f0;
  }

  .bv-md-math-block {
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 6px;
    padding: 10px;
    margin: 10px 0;
    font-family: monospace;
    text-align: center;
    color: #0284c7;
    font-size: 13.5px;
  }

  .bv-md-math-inline {
    color: #0284c7;
    font-weight: 600;
  }

  .bv-md-empty {
    color: #94a3b8;
    font-style: italic;
  }

  .bv-md-editor-wrap {
    padding: 12px;
    background: #f8fafc;
  }

  .bv-md-textarea {
    width: 100%;
    min-height: 120px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 12px;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 13px;
    line-height: 1.5;
    outline: none;
    resize: vertical;
    background: #ffffff;
    color: #1e293b;
  }

  .bv-md-editor-hint {
    margin-top: 6px;
    font-size: 11px;
    color: #64748b;
  }
</style>
