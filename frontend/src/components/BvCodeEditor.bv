<template>
  <div class="bv-code-editor-root">
    <!-- CODE EDITOR TOPBAR -->
    <div class="bv-editor-topbar">
      <div class="bv-editor-lang-tag">
        <span class="lang-dot"></span>
        <span class="lang-name">Object Pascal</span>
      </div>
      <div class="bv-editor-shortcuts">
        <span class="shortcut-pill"><code>Shift + Enter</code> Run</span>
        <span class="shortcut-pill"><code>Tab</code> Indent</span>
      </div>
    </div>

    <!-- MAIN EDITOR AREA WITH LINE GUTTER -->
    <div class="bv-editor-wrapper">
      <div class="bv-editor-gutter">
        <div b-for="line in lineNumbers" class="gutter-num">{{ line }}</div>
      </div>
      <div class="bv-editor-textarea-wrap">
        <textarea
          b-ref="codeTextarea"
          class="bv-code-textarea"
          :placeholder="placeholder"
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          @input="handleInput"
          @keydown="handleKeyDown"
        ></textarea>
      </div>
    </div>
  </div>
</template>

<script>
  {
    BvCodeEditor.bv - Reactive Code Editor with Object Pascal Highlights & Gutter
    Part of BlaiseNotebook Suite (Modified LGPL v2.1 with Linking Exception)
  }

  props:
    value: string = '';
    placeholder: string = '// Write your Object Pascal code here... (Shift + Enter to run)';
    readonly: boolean = false;

  data:
    lineCount: integer = 1;

  computed:
    function lineNumbers: JSValue;
    var
      arr: TJSArray;
      i, count: Integer;
    begin
      arr := TJSArray.new;
      count := Integer(this['lineCount']);
      if count < 1 then count := 1;
      for i := 1 to count do
        arr.push(i);
      Result := arr;
    end;

  methods:
    procedure updateLines;
    begin
      asm
        const val = this.value || '';
        const count = val.split('\n').length;
        this.lineCount = count > 0 ? count : 1;

        // Auto-adjust height and synchronize DOM textarea value
        const ta = this.$refs ? this.$refs.codeTextarea : null;
        if (ta) {
          if (ta.value !== val) {
            ta.value = val;
          }
          ta.style.height = 'auto';
          const newH = Math.max(80, ta.scrollHeight);
          ta.style.height = newH + 'px';
        }
      end;
    end;

    procedure handleInput(e: JSValue);
    var
      newVal: string;
    begin
      asm
        const target = e && e.target ? e.target : null;
        if (target) {
          newVal = target.value;
          this.value = newVal;
          this.updateLines();
          if (this.$emit) {
            this.$emit('input', newVal);
          }
        }
      end;
    end;

    procedure handleKeyDown(e: JSValue);
    begin
      asm
        const event = e;
        if (!event) return;

        // Shift + Enter: Execute code cell
        if (event.key === 'Enter' && event.shiftKey) {
          event.preventDefault();
          if (this.$emit) {
            this.$emit('run');
          }
          return;
        }

        // Ctrl + Enter: Execute code cell in-place
        if (event.key === 'Enter' && event.ctrlKey) {
          event.preventDefault();
          if (this.$emit) {
            this.$emit('run');
          }
          return;
        }

        // Tab: Insert 2 spaces
        if (event.key === 'Tab') {
          event.preventDefault();
          const target = event.target;
          const start = target.selectionStart;
          const endPos = target.selectionEnd;
          const val = target.value;

          target.value = val.substring(0, start) + '  ' + val.substring(endPos);
          target.selectionStart = target.selectionEnd = start + 2;

          this.value = target.value;
          this.updateLines();
          if (this.$emit) {
            this.$emit('input', this.value);
          }
        }
      end;
    end;

  mounted:
    begin
      this.updateLines();
    end;
</script>

<style>
  .bv-code-editor-root {
    background: #1e1e1e;
    border: 1px solid #334155;
    border-radius: 6px;
    overflow: hidden;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', 'Courier New', monospace;
  }

  .bv-editor-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #252526;
    padding: 4px 12px;
    border-bottom: 1px solid #333333;
    font-size: 11px;
  }

  .bv-editor-lang-tag {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3b82f6;
  }

  .lang-name {
    color: #9cdcfe;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .bv-editor-shortcuts {
    display: flex;
    gap: 8px;
  }

  .shortcut-pill {
    color: #858585;
    font-size: 10.5px;
  }

  .shortcut-pill code {
    background: #333333;
    color: #cccccc;
    padding: 1px 4px;
    border-radius: 3px;
    font-size: 10px;
  }

  .bv-editor-wrapper {
    display: flex;
    min-height: 80px;
    background: #1e1e1e;
  }

  .bv-editor-gutter {
    width: 44px;
    background: #1e1e1e;
    border-right: 1px solid #2d2d2d;
    padding: 8px 0;
    user-select: none;
    text-align: right;
  }

  .gutter-num {
    padding-right: 10px;
    font-size: 12px;
    line-height: 20px;
    color: #6e7681;
    font-family: inherit;
  }

  .bv-editor-textarea-wrap {
    flex: 1;
    position: relative;
  }

  .bv-code-textarea {
    width: 100%;
    min-height: 80px;
    padding: 8px 12px;
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    font-family: inherit;
    font-size: 13px;
    line-height: 20px;
    color: #d4d4d4;
    caret-color: #58a6ff;
    white-space: pre;
    overflow-wrap: normal;
    overflow-x: auto;
    box-sizing: border-box;
  }

  .bv-code-textarea::placeholder {
    color: #6a737d;
    font-style: italic;
  }
</style>
